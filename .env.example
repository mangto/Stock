# ── AI 설정 ─────────────────────────────────────────────
# 아래 중 쓰고 싶은 것의 키를 = 뒤에 넣으세요. 여러 개 넣으면 화면 위쪽에서 골라 쓸 수 있습니다.
# 수정 후에는 서버를 다시 시작해야 반영됩니다.

# Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# OpenAI (platform.openai.com)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.5

# Google Gemini (aistudio.google.com)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# 기본 모델이 혼잡(503)하거나 20초 안에 응답이 없으면 아래 순서대로 자동 전환 (쉼표로 구분)
# GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.6-flash

# OpenAI 호환 서버 (OpenRouter, Groq, DeepSeek, Ollama 등)
# 예) OpenRouter: https://openrouter.ai/api/v1   Ollama: http://localhost:11434/v1
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# 키가 여러 개일 때 기본으로 쓸 것: anthropic | openai | gemini | custom
# AI_PROVIDER=anthropic
